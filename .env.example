# Core
NODE_ENV="development"
DATABASE_URL="postgresql://user:password@localhost:26257/staynex?schema=public"
# Railway sets PORT automatically; API_PORT is mainly for local development.
# In Railway production, do not set API_PORT unless you also understand PORT routing.
API_PORT="4000"
CORS_ORIGIN="http://localhost:3000"

# Frontend
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Staff registration page is disabled in production unless explicitly enabled.
ENABLE_ADMIN_ACCESS_PAGE="false"
# Production reference:
# CORS_ORIGIN="https://staynexbookings.ng,https://www.staynexbookings.ng,https://staynex-frontend.vercel.app"
# NEXT_PUBLIC_APP_URL="https://staynexbookings.ng"
# NEXT_PUBLIC_API_URL="https://staynex-backend.up.railway.app"
GOOGLE_MAPS_API_KEY=""
# Google OAuth (Google Identity Services). NEXT_PUBLIC_ is exposed to the browser.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Email (Resend). Verify staynexbookings.ng in Resend before production use.
# Do not use onboarding@resend.dev for real users; it is only a Resend test sender.
RESEND_API_KEY=""
EMAIL_FROM="Staynex <support@staynexbookings.ng>"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Platform commission in basis points (1000 = 10%). Snapshotted onto each payment
# at checkout. Defaults to 1000 when unset.
PLATFORM_COMMISSION_BPS="1000"
# Required for owner media uploads to work at all. Without every one of these
# set, the API falls back to a non-functional dev stub and uploads fail.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
# Optional. Public URL prefix for uploaded objects — a custom domain mapped to
# the bucket, or its "R2.dev" public URL. Defaults to the R2.dev convention
# (https://<bucket>.<account-id>.r2.dev) when unset.
# IMPORTANT: the bucket's CORS policy must allow browser PUT from the frontend
# origins, not the Railway backend origin. Include:
#   https://staynexbookings.ng
#   https://www.staynexbookings.ng
#   http://localhost:3000
# Allow methods: PUT, GET, HEAD, OPTIONS
# Allow headers: Content-Type, *
# Expose headers: ETag
# Configure this in Cloudflare dashboard; app cannot set bucket CORS.
CLOUDFLARE_R2_PUBLIC_BASE_URL=""
# Push notifications (Firebase Cloud Messaging) — foundation/placeholder.
FCM_SERVER_KEY=""
FIREBASE_PROJECT_ID=""
# AI assistant (Google Gemini).
GEMINI_API_KEY=""
# Configurable so deployments can change models without a code release.
GEMINI_MODEL="gemini-2.5-flash"
# 6-digit access codes. Optional at boot; admin registration stays unavailable
# until both are set and they differ.
ADMIN_REVIEWER_ACCESS_CODE=""
ADMIN_MANAGER_ACCESS_CODE=""
# Optional session duration overrides in milliseconds. Admin sessions default to 12 hours.
SESSION_TTL_MS="15552000000"
ADMIN_SESSION_TTL_MS="43200000"
# Set in production so session cookies are scoped + marked Secure.
COOKIE_DOMAIN=""
# Optional. 64 hex chars for AES-256-GCM owner payout account-number encryption.
# When unset, Staynex stores only masked payout details.
OWNER_PAYOUT_ENCRYPTION_KEY=""
