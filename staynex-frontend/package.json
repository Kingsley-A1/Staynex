{
  "name": "@staynex/frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "next typegen && tsc --noEmit",
    "test:ai": "node --experimental-strip-types --test test/assistant-transport-ui.test.mjs",
    "test:host-admin": "node --test test/host-admin-ui-regressions.test.mjs",
    "perf:budget": "node scripts/performance-budget.mjs",
    "perf:lighthouse:mobile": "npx --yes lighthouse https://www.staynexbookings.ng/ --only-categories=performance --output=html --output-path=./lighthouse-mobile.html --chrome-flags=\"--headless=new --no-sandbox\"",
    "perf:lighthouse:desktop": "npx --yes lighthouse https://www.staynexbookings.ng/ --only-categories=performance --preset=desktop --output=html --output-path=./lighthouse-desktop.html --chrome-flags=\"--headless=new --no-sandbox\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "firebase": "^12.15.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  }
}
