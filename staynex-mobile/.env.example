# Staynex mobile (Expo) environment.
#
# Copy to `.env` and fill in. Expo loads this file automatically at start.
# Never commit `.env`. See app.config.ts for how these are consumed.

# Required. Root of the NestJS API, no trailing slash.
#
# The host differs by target, because "localhost" on a device or emulator is
# the device itself, not your machine:
#   Android emulator -> http://10.0.2.2:8080
#   iOS simulator    -> http://localhost:8080
#   Physical device  -> http://<your-LAN-IP>:8080
STAYNEX_API_BASE_URL="http://localhost:8080"

# Optional. Google sign-in.
GOOGLE_CLIENT_ID=""

# Optional. Set automatically by `eas init`.
EAS_PROJECT_ID=""
