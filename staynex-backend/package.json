{
  "name": "@staynex/backend",
  "private": true,
  "version": "0.1.0",
  "exports": {
    "./types": {
      "types": "./types/index.ts",
      "default": "./types/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "pnpm prisma:generate",
    "build": "nest build",
    "start": "pnpm prisma:migrate:deploy && node dist/src/main.js",
    "start:runtime": "node dist/src/main.js",
    "check": "tsc --noEmit",
    "test:property-review": "pnpm build && node --test test/property-review-policy.test.cjs",
    "test:emails": "pnpm build && node --test test/email-templates.test.cjs",
    "email:preview": "pnpm build && node scripts/preview-emails.cjs",
    "test:ai": "node --experimental-strip-types --test test/ai-reliability.test.mjs test/ai-context.test.mjs test/ai-message-actions.test.mjs",
    "test:payments": "pnpm build && node --test test/paystack-bank-verification.test.mjs",
    "test:availability": "pnpm build && node --test test/availability.test.cjs",
    "test:workspace": "pnpm build && node --test test/rooms.test.cjs test/notification-inbox.test.cjs test/platform-lifecycle-source.test.cjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.14.0",
    "@react-pdf/renderer": "^4.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "prisma": "^6.14.0",
    "typescript": "^5.9.2"
  }
}
