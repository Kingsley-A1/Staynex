// Staynex Prisma schema — single source of truth for persistence.
// Database: CockroachDB-compatible PostgreSQL. Money is stored as integer
// minor units (kobo) to avoid floating-point error. Do not add Drizzle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  GUEST
  OWNER
  ADMIN_REVIEWER
  ADMIN_MANAGER
}

// Additive capability grants. GUEST is implicit for every signed-in user, so it
// is not stored here — owner/admin privileges are layered on top via grants.
// `User.role` is kept as a compatibility mirror (see User model).
enum AppCapability {
  OWNER
  ADMIN_REVIEWER
  ADMIN_MANAGER
}

enum PayoutMethodStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum AreaType {
  LOCAL_GOVERNMENT_AREA
  NEIGHBORHOOD
}

enum TestimonialStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PropertyReviewStatus {
  NOT_SUBMITTED
  PENDING
  FAILED
  SCHEDULED
  PUBLISHED
  CANCELLED
  MANUAL_REVIEW
}

enum PropertyReviewSource {
  AUTO_REVIEW
  ADMIN_OVERRIDE
}

enum PropertyReviewCheckStatus {
  PASS
  FAIL
  WARNING
}

enum BookingStatus {
  HOLD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  /// Provider captured funds but the platform cannot honor a booking (late
  /// success with no remaining capacity, underpayment, currency mismatch).
  /// Terminal path out is an admin-issued refund -> REFUNDED. Never silent.
  REQUIRES_REFUND
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationChannel {
  EMAIL
  PUSH
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

/// What a notification is about — drives inbox grouping, dedupe, and deep links.
enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REFUNDED
  PAYOUT_PAID
  PAYOUT_FAILED
  PAYMENT_EXCEPTION
  PROPERTY_REVIEW
  PROPERTY_AVAILABILITY
  CHECKIN_REMINDER
  GENERAL
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

// ---------------------------------------------------------------------------
// Identity & profiles
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String?
  phone        String?
  /// scrypt hash as `salt:hash`. Null for seeded/demo users without a password.
  passwordHash String?
  /// COMPAT: primary role kept so existing role-based guards/UIs keep working.
  /// Capabilities (below) are the forward-compatible source of truth; this mirror
  /// stays in sync (a pure-owner registration sets OWNER here and grants OWNER).
  role         UserRole @default(GUEST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guestProfile     GuestProfile?
  ownerProfile     OwnerProfile?
  capabilities     UserCapability[]
  ownerLocations   OwnerLocation[]      @relation("OwnerLocations")
  payoutMethod     OwnerPayoutMethod?
  passwordResets   PasswordResetToken[]
  ownedProperties  Property[]           @relation("PropertyOwner")
  bookings         Booking[]
  bookingHolds     BookingHold[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  aiConversations  AIConversation[]
  auditLogs        AuditLog[]           @relation("AuditActor")
  sessions         Session[]
  mfaChallenges    MfaChallenge[]
  testimonials     Testimonial[]
  payouts          Payout[]             @relation("PayoutOwner")
  processedPayouts Payout[]             @relation("PayoutProcessor")

  @@index([role])
}

// Additive privilege grant for a user (owner/admin). Unique per (user, capability).
// Guest capability is implicit and never stored.
model UserCapability {
  id         String        @id @default(cuid())
  userId     String
  capability AppCapability
  grantedAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hash of the raw cookie token. Older raw tokens are upgraded on use.
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MfaChallenge {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model GuestProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  businessName          String?
  phone                 String?
  /// Set once the owner finishes onboarding readiness (profile + ≥1 location +
  /// payout saved or explicitly skipped). Null while onboarding is incomplete.
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// An owner's operating/property location. Owners can have several; the canonical
// per-listing location stays on Property.cityId/areaId. Property.ownerLocationId
// is an optional link used to detect (and migrate) locations still in use.
model OwnerLocation {
  id          String   @id @default(cuid())
  ownerId     String
  cityId      String
  areaId      String?
  label       String?
  addressLine String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User       @relation("OwnerLocations", fields: [ownerId], references: [id], onDelete: Cascade)
  city       City       @relation(fields: [cityId], references: [id])
  area       Area?      @relation(fields: [areaId], references: [id])
  properties Property[]

  @@index([ownerId])
  @@index([cityId])
}

// Owner payout (manual settlement v1). Never stores raw card data. The full bank
// account number is encrypted at rest (AES-256-GCM) only when
// OWNER_PAYOUT_ENCRYPTION_KEY is configured; otherwise only the last 4 are kept.
// Revealing the full number is ADMIN_MANAGER-only and writes an AuditLog.
model OwnerPayoutMethod {
  id                 String             @id @default(cuid())
  ownerId            String             @unique
  bankCode           String?
  bankName           String
  accountName        String
  accountNumberLast4 String
  /// `iv:authTag:ciphertext` (all hex) when encryption is configured, else null.
  accountNumberEnc   String?
  provider           String?
  status             PayoutMethodStatus @default(PENDING_VERIFICATION)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// Provider-authoritative payout bank directory. Paystack remains the source of
// truth; this table is the durable fallback when its list endpoint is briefly
// unavailable and avoids shipping a stale bank list in frontend code.
model BankDirectoryEntry {
  id           String   @id @default(cuid())
  provider     String
  country      String
  currency     String
  code         String
  name         String
  type         String?
  active       Boolean  @default(true)
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, country, code])
  @@index([provider, country, active, name])
}

// Single-use, hashed, expiring password-reset token. The raw token is only ever
// emailed to the user; the DB stores its SHA-256 hash.
// Password recovery. `tokenHash` holds the scrypt hash of a 6-digit code
// (looked up by userId, not by hash), and `attempts` caps brute-force guesses
// against that short code — mirrors MfaChallenge.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Location hierarchy
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions Region[]
  cities  City[]
}

model Region {
  id        String   @id @default(cuid())
  countryId String
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@index([countryId])
}

model City {
  id        String   @id @default(cuid())
  countryId String
  regionId  String?
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country        Country         @relation(fields: [countryId], references: [id])
  region         Region?         @relation(fields: [regionId], references: [id])
  properties     Property[]
  areas          Area[]
  ownerLocations OwnerLocation[]

  @@index([countryId])
  @@index([regionId])
}

// Local areas within a city. Scalable by `type` (LGA / neighborhood) and
// admin-editable. `notable` areas surface first in search.
model Area {
  id        String   @id @default(cuid())
  cityId    String
  name      String
  slug      String   @unique
  type      AreaType @default(NEIGHBORHOOD)
  notable   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city           City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties     Property[]
  ownerLocations OwnerLocation[]

  @@index([cityId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Supply: properties, rooms, media
// ---------------------------------------------------------------------------

model Property {
  id                 String                @id @default(cuid())
  ownerId            String
  cityId             String
  areaId             String?
  /// Optional link to the owner's saved location. Canonical listing location stays
  /// on cityId/areaId; this only records which OwnerLocation a listing belongs to.
  ownerLocationId    String?
  name               String
  slug               String                @unique
  description        String?
  status             PropertyStatus        @default(DRAFT)
  /// Incremented whenever owner-controlled listing content changes. Auto-publish
  /// only releases a property if the reviewed version is still current.
  contentVersion     Int                   @default(1)
  reviewStatus       PropertyReviewStatus  @default(NOT_SUBMITTED)
  reviewSource       PropertyReviewSource?
  reviewedAt         DateTime?
  scheduledPublishAt DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  owner         User                @relation("PropertyOwner", fields: [ownerId], references: [id])
  city          City                @relation(fields: [cityId], references: [id])
  area          Area?               @relation(fields: [areaId], references: [id])
  ownerLocation OwnerLocation?      @relation(fields: [ownerLocationId], references: [id])
  media         PropertyMedia[]
  roomTypes     RoomType[]
  payouts       Payout[]
  auditLogs     AuditLog[]
  testimonials  Testimonial[]
  reviewRuns    PropertyReviewRun[]

  @@index([ownerId])
  @@index([cityId])
  @@index([areaId])
  @@index([ownerLocationId])
  @@index([status])
  @@index([reviewStatus])
  @@index([scheduledPublishAt])
}

model PropertyReviewRun {
  id                 String               @id @default(cuid())
  propertyId         String
  contentVersion     Int
  source             PropertyReviewSource @default(AUTO_REVIEW)
  status             PropertyReviewStatus @default(PENDING)
  riskScore          Int                  @default(0)
  summary            String?
  scheduledPublishAt DateTime?
  publishedAt        DateTime?
  createdAt          DateTime             @default(now())
  completedAt        DateTime?

  property Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  checks   PropertyReviewCheck[]

  @@index([propertyId])
  @@index([status])
  @@index([scheduledPublishAt])
  @@index([propertyId, contentVersion])
}

model PropertyReviewCheck {
  id        String                    @id @default(cuid())
  runId     String
  key       String
  label     String
  status    PropertyReviewCheckStatus
  severity  String
  details   String
  createdAt DateTime                  @default(now())

  run PropertyReviewRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  mediaType  MediaType @default(IMAGE)
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model RoomType {
  id            String   @id @default(cuid())
  propertyId    String
  name          String
  description   String?
  /// Nightly base price in minor units (kobo).
  basePriceKobo Int      @default(0)
  maxGuests     Int      @default(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property     Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomUnits    RoomUnit[]
  media        RoomMedia[]
  availability AvailabilityCalendar[]

  @@index([propertyId])
}

model RoomUnit {
  id         String   @id @default(cuid())
  roomTypeId String
  code       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookingHolds BookingHold[]
  bookings     Booking[]

  @@index([roomTypeId])
}

model RoomMedia {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  mediaType  MediaType @default(IMAGE)
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
}

// ---------------------------------------------------------------------------
// Availability (capacity per room type per day)
// ---------------------------------------------------------------------------

model AvailabilityCalendar {
  id          String   @id @default(cuid())
  roomTypeId  String
  date        DateTime @db.Date
  totalUnits  Int
  bookedUnits Int      @default(0)
  heldUnits   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Demand: holds, bookings, payments, payouts
// ---------------------------------------------------------------------------

model BookingHold {
  id               String   @id @default(cuid())
  userId           String?
  roomUnitId       String
  checkIn          DateTime
  checkOut         DateTime
  /// Occupancy split. Capacity is checked against adults + children; infants are
  /// free and excluded from the room's maxGuests check.
  adults           Int      @default(1)
  children         Int      @default(0)
  infants          Int      @default(0)
  /// Price snapshot taken when the hold is created (kobo). Checkout charges
  /// this snapshot, so a host price edit mid-flow can never change what the
  /// guest was quoted. 0 only on legacy pre-snapshot rows.
  nightlyPriceKobo Int      @default(0)
  totalKobo        Int      @default(0)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User?    @relation(fields: [userId], references: [id])
  roomUnit RoomUnit @relation(fields: [roomUnitId], references: [id])

  @@index([roomUnitId])
  @@index([userId])
  @@index([expiresAt])
}

model Booking {
  id         String        @id @default(cuid())
  userId     String?
  /// Contact email captured at checkout. Anonymous guests have no User row, so
  /// this is how confirmation emails are addressed and admins see the guest.
  guestEmail String?
  roomUnitId String
  status     BookingStatus @default(HOLD)
  checkIn    DateTime
  checkOut   DateTime
  /// Occupancy split carried over from the hold. Capacity = adults + children;
  /// infants are excluded from the room's maxGuests check.
  adults     Int           @default(1)
  children   Int           @default(0)
  infants    Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user        User?        @relation(fields: [userId], references: [id])
  roomUnit    RoomUnit     @relation(fields: [roomUnitId], references: [id])
  payment     Payment?
  payout      Payout?
  testimonial Testimonial?

  @@index([roomUnitId])
  @@index([userId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  /// COMPAT: mirror of `grossAmountKobo`. Kept so older rows/readers keep working;
  /// all new accounting logic reads the explicit fields below. Always equals
  /// `grossAmountKobo` for payments created on/after Phase A.
  amount            Int
  /// Full amount charged to the guest (minor units, kobo). Canonical gross.
  grossAmountKobo   Int           @default(0)
  /// Staynex commission retained from gross (kobo).
  platformFeeKobo   Int           @default(0)
  /// Net amount owed to the property owner (kobo) = gross - platform fee.
  ownerPayoutKobo   Int           @default(0)
  /// Commission rate snapshotted at checkout, in basis points (1000 = 10%).
  /// Snapshotted so historical accounting never shifts if the platform rate changes.
  commissionRateBps Int           @default(0)
  currency          String        @default("NGN")
  provider          String?
  reference         String?       @unique
  status            PaymentStatus @default(PENDING)
  /// Set once when the payment is verified SUCCESS.
  paidAt            DateTime?
  /// Last provider verification time — debounces status-page polling so the
  /// platform never hammers Paystack's verify API.
  lastVerifiedAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payout  Payout?

  @@index([status])
}

/// Immutable money audit trail: one row per provider webhook delivery, per
/// provider verification that changed state, and per admin money action —
/// always with the processing outcome. Nothing that touches funds may resolve
/// invisibly (payment-review P1).
model PaymentEvent {
  id        String   @id @default(cuid())
  provider  String   @default("paystack")
  /// e.g. charge.success, charge.failed, refund.processed, sync.verify, admin.refund
  eventType String
  reference String?
  /// Processing result: CONFIRMED, DUPLICATE, REVIVED, REQUIRES_REFUND,
  /// UNDERPAID, CURRENCY_MISMATCH, UNKNOWN_REFERENCE, RECORDED, FAILED, ...
  outcome   String
  /// Short human-readable explanation for the admin timeline.
  detail    String?
  /// Raw provider payload (webhook deliveries only).
  payload   Json?
  createdAt DateTime @default(now())

  @@index([reference])
  @@index([outcome])
  @@index([createdAt])
}

// Guest rating + testimonial, always tied to a real booking (bookingId unique →
// one per booking). New testimonials are PENDING_REVIEW; only APPROVED show
// publicly. Approval authority is the backend/admin (skill.md §9).
model Testimonial {
  id         String            @id @default(cuid())
  bookingId  String            @unique
  userId     String?
  propertyId String
  /// 1–5 stars.
  rating     Int
  title      String?
  body       String
  guestName  String?
  status     TestimonialStatus @default(PENDING_REVIEW)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
}

// A single owner settlement for one successful payment. Created (PENDING) by the
// backend only when a payment is verified SUCCESS and its booking CONFIRMED.
// Phase A: payouts are settled manually by an admin; Phase B automates transfers.
model Payout {
  id                String       @id @default(cuid())
  bookingId         String       @unique
  paymentId         String       @unique
  ownerId           String
  propertyId        String
  /// Net amount owed to the owner in minor units (kobo) = payment.ownerPayoutKobo.
  amount            Int
  currency          String       @default("NGN")
  status            PayoutStatus @default(PENDING)
  /// When this payout becomes eligible to settle (checkIn + 24h).
  eligibleAt        DateTime
  /// Set when an admin approves the payout for settlement (Phase B workflow hook).
  approvedAt        DateTime?
  /// Set when the payout has actually been paid to the owner (manual in Phase A).
  paidAt            DateTime?
  /// Set when an admin marks the payout FAILED (reason lives in `note`).
  failedAt          DateTime?
  /// Settlement note: bank-transfer reference on PAID, reason on FAILED,
  /// clawback explanation when a refund cancels the payout.
  note              String?
  /// Admin who last actioned this payout (manual settlement marker).
  processedByUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  owner       User     @relation("PayoutOwner", fields: [ownerId], references: [id])
  property    Property @relation(fields: [propertyId], references: [id])
  processedBy User?    @relation("PayoutProcessor", fields: [processedByUserId], references: [id])

  @@index([propertyId])
  @@index([ownerId])
  @@index([status])
  @@index([eligibleAt])
}

// ---------------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------------

model Notification {
  id        String              @id @default(cuid())
  // userId is optional because anonymous guests still receive (and we still log)
  // booking confirmation emails addressed by `email`.
  userId    String?
  bookingId String?
  email     String?
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  type      NotificationType    @default(GENERAL)
  title     String
  body      String
  /// Optional visual context for property-specific inbox items.
  imageUrl  String?
  /// In-app deep link (e.g. /host/bookings/xyz).
  linkUrl   String?
  /// Set when the user opens/acknowledges an IN_APP notification.
  readAt    DateTime?
  /// Idempotency key so a trigger firing twice can never double-notify.
  dedupeKey String?             @unique
  /// Outbox: delivery attempts made so far (EMAIL/PUSH retry bookkeeping).
  attempts  Int                 @default(0)
  /// Outbox: the exact deliverable (email {to,subject,html,text} or push
  /// {title,body,linkUrl}) so the retry dispatcher can re-send verbatim.
  payload   Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId])
  @@index([bookingId])
  @@index([status])
}

/// A push-capable device (FCM registration token) tied to a signed-in user.
/// Tokens are upserted on login/opt-in and pruned when FCM reports them dead.
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform @default(WEB)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  propertyId  String?
  action      String
  entityType  String
  entityId    String
  createdAt   DateTime @default(now())

  actor     User?         @relation("AuditActor", fields: [actorUserId], references: [id])
  property  Property?     @relation(fields: [propertyId], references: [id])
  aiActions AIActionLog[]

  @@index([actorUserId])
  @@index([propertyId])
  @@index([entityType, entityId])
}

model WebVitalMetric {
  id             String   @id @default(cuid())
  metricId       String
  name           String
  value          Float
  rating         String?
  navigationType String?
  route          String
  target         Float?
  targetMet      Boolean?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([route, createdAt])
}

// ---------------------------------------------------------------------------
// AI assistant logs (tool-first; never an authority of record)
// ---------------------------------------------------------------------------

enum AIMessageRole {
  USER
  AGENT
}

enum AIMessageFeedback {
  UP
  DOWN
}

model AIConversation {
  id        String    @id @default(cuid())
  userId    String?
  topic     String?
  title     String?
  pinned    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  actions  AIActionLog[]
  messages AIMessage[]

  @@index([userId])
}

// Persisted Staynex AI chat messages (history is DB-backed, not faked in
// component state). Conversations are private to their owner.
model AIMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  feedback       AIMessageFeedback?
  feedbackAt     DateTime?
  supersededAt   DateTime?
  /// Public, verified property summaries shown with an assistant response.
  /// These are snapshots from the live catalog at generation time.
  propertyCards  Json?
  createdAt      DateTime           @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, supersededAt, createdAt])
}

model AIActionLog {
  id             String   @id @default(cuid())
  conversationId String
  auditLogId     String?
  actionType     String
  /// Short, non-sensitive description for admin AI-log visibility
  /// (e.g. "Compared rooms", "Refused: availability claim").
  summary        String?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auditLog     AuditLog?      @relation(fields: [auditLogId], references: [id])

  @@index([conversationId])
  @@index([auditLogId])
}
